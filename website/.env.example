# Environment variables template
# Copy this file to .env.local for local development (Next.js loads it automatically).
# NEXT_PUBLIC_* vars are baked in at build time — see deploy-website.yml build args.

# Strapi CMS URL
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Stripe public key (pricing/checkout plumbing is inert/display-only in Phase 1 — ADR-8)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GrowthBook client key (feature flagging)
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# ---------------------------------------------------------------------------
# Product backend (guest essay flow — Phase 1 build, KAN-2 onward).
# Points at the local Postgres started by `docker compose up -d db` at the
# repo root, never at the shared production Cloud SQL instance. See
# CONTRIBUTING.md and Architecture Decisions ADR-1/ADR-10 (Confluence, MFS).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://fluentina:fluentina_dev@localhost:55432/fluentina

# ---------------------------------------------------------------------------
# KAN-25 — the per-address rate-limit backstops, server-only (never
# NEXT_PUBLIC_*). Optional: both default sensibly (see
# src/lib/domain/rate-limit.ts's own comment for the reasoning behind each
# default) — set these only to retune a cap against real traffic without a
# rebuild.
#
# Accepted format: plain digits only, no leading/trailing characters other
# than whitespace (which is trimmed) — e.g. "120", or "  120  ". Rejected,
# each falling back silently to the default above except for one WARNING
# logged once at startup (positiveIntEnv, src/lib/domain/rate-limit.ts):
#   - anything non-numeric ("abc")
#   - scientific notation ("1e4" — NOT read as 10000)
#   - a fractional value ("5.5" — NOT rounded or floored)
#   - a leading sign, "+" or "-" ("+5", "-5")
#   - zero or negative
#   - a value too large to represent exactly (over ~9 quadrillion,
#     Number.MAX_SAFE_INTEGER) — a large typo, not a real override
# ---------------------------------------------------------------------------
# RATE_LIMIT_ESSAY_SUBMISSION_IP_LIMIT=120
# RATE_LIMIT_GUEST_SESSION_RESOLVE_IP_LIMIT=240

# KAN-20 — the caps on POST /api/auth/register (default 10/hour per address,
# 5/hour per guest cookie) and POST /api/auth/login (default 30/hour per
# address). Same accepted format as above. Ten registrations an hour is tight
# for a classroom registering together behind one shared egress address —
# retune against real traffic. The per-email login cap (10) is fixed by the
# design and is not overridable.
# RATE_LIMIT_REGISTRATION_IP_LIMIT=10
# RATE_LIMIT_REGISTRATION_SESSION_LIMIT=5
# RATE_LIMIT_LOGIN_IP_LIMIT=30

# KAN-20 — NOT an application variable, a recommendation for the Cloud Run
# service definition (a deployment change nobody has made): UV_THREADPOOL_SIZE=2.
# Password hashing (scrypt, ~90 ms and 32 MiB each) runs on Node's libuv
# threadpool; the default of 4 lets four run at once (128 MiB) inside a 512 Mi
# instance. Two bounds that to 64 MiB, at the price of queueing when several
# sign-ins land at once on one CPU.

# ---------------------------------------------------------------------------
# KAN-16 — AI grading (ADR-4/ADR-5), server-only.
# ---------------------------------------------------------------------------

# Anthropic Claude — the Phase 1 primary provider (KAN-44, amending ADR-4).
# Required only when MOCK_GRADING_PROVIDER is unset/not "1" and grading runs
# against the real provider. Read at call time, never at import, so leaving
# it unset is fine for dev, tests and CI. Uses the official
# @anthropic-ai/sdk. NOT committed here — the placeholder below is not a
# key. Production needs a Secret Manager entry (`anthropic-api-key`) plus
# wiring into deploy-website.yml as a runtime env var (Cloud Run secret
# mount), not a NEXT_PUBLIC_* build arg — this is never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Which real provider grading uses when MOCK_GRADING_PROVIDER is not "1".
# Unset (or any unrecognised value) selects Claude. "mistral" selects the
# Mistral provider, kept working as the deferred second step.
# GRADING_PROVIDER=mistral

# Mistral AI ("La Plateforme") — the deferred second-step provider. Only
# needed when GRADING_PROVIDER=mistral; a plain REST call, no SDK. NOT
# committed here — would need a Secret Manager entry (`mistral-api-key`)
# wired the same way as the Anthropic key above.
# MISTRAL_API_KEY=

# Set to "1" to select the deterministic fake GradingProvider instead of a
# real one — zero network calls, zero cost. Wins over GRADING_PROVIDER and
# any API key. Already set by ci.yml for the built app and for Playwright;
# set it locally too for `npm run dev`/`npm run test` unless you specifically
# want to exercise the real provider call (which then also needs
# ANTHROPIC_API_KEY, or MISTRAL_API_KEY with GRADING_PROVIDER=mistral).
MOCK_GRADING_PROVIDER=1

# ADR-2 — which grading queue implementation POST /api/essays' grading
# dispatch (lib/domain/grading/queue.ts) uses. "inline" (the default, and
# what this line being absent/unset means) runs the grading job directly, in
# this same process, no GCP resources needed — what npm run dev/test/test:e2e
# all use. "cloud-tasks" is the production path; setting it locally without
# also configuring every GRADING_TASKS_*/GRADING_TASK_SECRET var below makes
# grading dispatch fail loudly rather than silently no-op.
# GRADING_QUEUE_MODE=inline

# --- Cloud Tasks production wiring (GRADING_QUEUE_MODE=cloud-tasks only) ---
# None of these are used, or need to be set, in local dev or in CI — see
# queue.ts's own comment. Deployment wiring (deploy-website.yml env vars,
# the queue and its IAM bindings) is still outstanding — see this story's
# own PR/handover notes.
# GCP_PROJECT_ID=writewise-468912
# GRADING_TASKS_QUEUE_LOCATION=europe-west10
# GRADING_TASKS_QUEUE_NAME=grading-jobs
# GRADING_TASKS_TARGET_URL=https://writewise-website-xxxxx.a.run.app/api/internal/grading-jobs/process
# GRADING_TASKS_SERVICE_ACCOUNT_EMAIL=grading-tasks@writewise-468912.iam.gserviceaccount.com
# A shared secret the internal processing route checks on every call — see
# that route's own comment for why this, not full OIDC verification, is
# Phase 1's answer. NOT committed — needs a Secret Manager entry
# (`grading-task-secret`) generated with, e.g., `openssl rand -hex 32`.
# GRADING_TASK_SECRET=
