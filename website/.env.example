# Environment variables template
# Copy this file to .env.local for local development (Next.js loads it automatically).
# NEXT_PUBLIC_* vars are baked in at build time — see deploy-website.yml build args.

# Strapi CMS URL
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Stripe public key (pricing/checkout plumbing is inert/display-only in Phase 1 — ADR-8)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GrowthBook client key (feature flagging)
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# ---------------------------------------------------------------------------
# Product backend (guest essay flow — Phase 1 build, KAN-2 onward).
# Points at the local Postgres started by `docker compose up -d db` at the
# repo root, never at the shared production Cloud SQL instance. See
# CONTRIBUTING.md and Architecture Decisions ADR-1/ADR-10 (Confluence, MFS).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://fluentina:fluentina_dev@localhost:55432/fluentina

# ---------------------------------------------------------------------------
# KAN-25 — the per-address rate-limit backstops, server-only (never
# NEXT_PUBLIC_*). Optional: both default sensibly (see
# src/lib/domain/rate-limit.ts's own comment for the reasoning behind each
# default) — set these only to retune a cap against real traffic without a
# rebuild.
# ---------------------------------------------------------------------------
# RATE_LIMIT_ESSAY_SUBMISSION_IP_LIMIT=120
# RATE_LIMIT_GUEST_SESSION_RESOLVE_IP_LIMIT=240
